{
  "name": "pi-tab-title",
  "version": "1.0.0",
  "description": "Automatic session titles and task status icons in the terminal tab, for the Pi coding agent.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukeinx/pi-tab-title.git"
  },
  "homepage": "https://github.com/lukeinx/pi-tab-title#readme",
  "bugs": { "url": "https://github.com/lukeinx/pi-tab-title/issues" },
  "keywords": ["pi-package", "pi-extension", "terminal", "tab-title", "session-title", "osc", "title"],
  "engines": { "node": ">=22.19.0" },
  "files": ["index.ts", "README.md", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.0.0",
    "typebox": "1.3.31",
    "typescript": "~5.9.3"
  }
}
